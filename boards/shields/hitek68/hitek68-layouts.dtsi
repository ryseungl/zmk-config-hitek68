// Physical layout for ZMK Studio support.
// Key order matches the keymap bindings / matrix transform (96 positions).
// Unpopulated matrix positions are zero-size.

#include <physical_layouts.dtsi>

/ {
    default_layout: default_layout {
        compatible = "zmk,physical-layout";
        display-name = "Hitek68";
        transform = <&default_transform>;
        // kscan comes from the chosen node (varies per build).

        keys  //                      w    h    x     y     rot   rx    ry
            = <&key_physical_attrs 100 100    0    0     0    0    0>  /* pos 0 */
            , <&key_physical_attrs 100 100  100    0     0    0    0>  /* pos 1 */
            , <&key_physical_attrs 100 100  200    0     0    0    0>  /* pos 2 */
            , <&key_physical_attrs 100 100  300    0     0    0    0>  /* pos 3 */
            , <&key_physical_attrs 100 100  400    0     0    0    0>  /* pos 4 */
            , <&key_physical_attrs 100 100  500    0     0    0    0>  /* pos 5 */
            , <&key_physical_attrs   0   0    0    0     0    0    0>
            , <&key_physical_attrs   0   0    0    0     0    0    0>
            , <&key_physical_attrs 100 100    0  100     0    0    0>  /* pos 8 */
            , <&key_physical_attrs 100 100  100  100     0    0    0>  /* pos 9 */
            , <&key_physical_attrs 100 100  200  100     0    0    0>  /* pos 10 */
            , <&key_physical_attrs 100 100  300  100     0    0    0>  /* pos 11 */
            , <&key_physical_attrs 100 100  400  100     0    0    0>  /* pos 12 */
            , <&key_physical_attrs 100 100  500  100     0    0    0>  /* pos 13 */
            , <&key_physical_attrs 100 100  600  100     0    0    0>  /* pos 14 */
            , <&key_physical_attrs   0   0    0    0     0    0    0>
            , <&key_physical_attrs 100 100    0  200     0    0    0>  /* pos 16 */
            , <&key_physical_attrs 100 100  100  200     0    0    0>  /* pos 17 */
            , <&key_physical_attrs 100 100  200  200     0    0    0>  /* pos 18 */
            , <&key_physical_attrs 100 100  300  200     0    0    0>  /* pos 19 */
            , <&key_physical_attrs 100 100  400  200     0    0    0>  /* pos 20 */
            , <&key_physical_attrs 100 100  500  200     0    0    0>  /* pos 21 */
            , <&key_physical_attrs 100 100  600  200     0    0    0>  /* pos 22 */
            , <&key_physical_attrs   0   0    0    0     0    0    0>
            , <&key_physical_attrs 100 100    0  300     0    0    0>  /* pos 24 */
            , <&key_physical_attrs 100 100  100  300     0    0    0>  /* pos 25 */
            , <&key_physical_attrs 100 100  200  300     0    0    0>  /* pos 26 */
            , <&key_physical_attrs 100 100  300  300     0    0    0>  /* pos 27 */
            , <&key_physical_attrs 100 100  400  300     0    0    0>  /* pos 28 */
            , <&key_physical_attrs 100 100  500  300     0    0    0>  /* pos 29 */
            , <&key_physical_attrs 100 100  600  300     0    0    0>  /* pos 30 */
            , <&key_physical_attrs   0   0    0    0     0    0    0>
            , <&key_physical_attrs   0   0    0    0     0    0    0>
            , <&key_physical_attrs   0   0    0    0     0    0    0>
            , <&key_physical_attrs   0   0    0    0     0    0    0>
            , <&key_physical_attrs   0   0    0    0     0    0    0>
            , <&key_physical_attrs 100 100  400  400     0    0    0>  /* pos 36 */
            , <&key_physical_attrs 100 100  500  400     0    0    0>  /* pos 37 */
            , <&key_physical_attrs 150 100  600  400     0    0    0>  /* pos 38 */
            , <&key_physical_attrs 100 100  675  300     0    0    0>  /* pos 39 */
            , <&key_physical_attrs   0   0    0    0     0    0    0>
            , <&key_physical_attrs   0   0    0    0     0    0    0>
            , <&key_physical_attrs   0   0    0    0     0    0    0>
            , <&key_physical_attrs   0   0    0    0     0    0    0>
            , <&key_physical_attrs 100 100  400  500     0    0    0>  /* pos 44 */
            , <&key_physical_attrs 100 100  500  500     0    0    0>  /* pos 45 */
            , <&key_physical_attrs 150 100  600  500     0    0    0>  /* pos 46 */
            , <&key_physical_attrs   0   0    0    0     0    0    0>
            , <&key_physical_attrs 100 100 1500    0     0    0    0>  /* pos 48 */
            , <&key_physical_attrs 100 100 1400    0     0    0    0>  /* pos 49 */
            , <&key_physical_attrs 100 100 1300    0     0    0    0>  /* pos 50 */
            , <&key_physical_attrs 100 100 1200    0     0    0    0>  /* pos 51 */
            , <&key_physical_attrs 100 100 1100    0     0    0    0>  /* pos 52 */
            , <&key_physical_attrs 100 100 1000    0     0    0    0>  /* pos 53 */
            , <&key_physical_attrs   0   0    0    0     0    0    0>
            , <&key_physical_attrs   0   0    0    0     0    0    0>
            , <&key_physical_attrs 100 100 1500  100     0    0    0>  /* pos 56 */
            , <&key_physical_attrs 100 100 1400  100     0    0    0>  /* pos 57 */
            , <&key_physical_attrs 100 100 1300  100     0    0    0>  /* pos 58 */
            , <&key_physical_attrs 100 100 1200  100     0    0    0>  /* pos 59 */
            , <&key_physical_attrs 100 100 1100  100     0    0    0>  /* pos 60 */
            , <&key_physical_attrs 100 100 1000  100     0    0    0>  /* pos 61 */
            , <&key_physical_attrs 100 100  900  100     0    0    0>  /* pos 62 */
            , <&key_physical_attrs   0   0    0    0     0    0    0>
            , <&key_physical_attrs 100 100 1500  200     0    0    0>  /* pos 64 */
            , <&key_physical_attrs 100 100 1400  200     0    0    0>  /* pos 65 */
            , <&key_physical_attrs 100 100 1300  200     0    0    0>  /* pos 66 */
            , <&key_physical_attrs 100 100 1200  200     0    0    0>  /* pos 67 */
            , <&key_physical_attrs 100 100 1100  200     0    0    0>  /* pos 68 */
            , <&key_physical_attrs 100 100 1000  200     0    0    0>  /* pos 69 */
            , <&key_physical_attrs 100 100  900  200     0    0    0>  /* pos 70 */
            , <&key_physical_attrs   0   0    0    0     0    0    0>
            , <&key_physical_attrs 100 100 1500  300     0    0    0>  /* pos 72 */
            , <&key_physical_attrs 100 100 1400  300     0    0    0>  /* pos 73 */
            , <&key_physical_attrs 100 100 1300  300     0    0    0>  /* pos 74 */
            , <&key_physical_attrs 100 100 1200  300     0    0    0>  /* pos 75 */
            , <&key_physical_attrs 100 100 1100  300     0    0    0>  /* pos 76 */
            , <&key_physical_attrs 100 100 1000  300     0    0    0>  /* pos 77 */
            , <&key_physical_attrs 100 100  900  300     0    0    0>  /* pos 78 */
            , <&key_physical_attrs   0   0    0    0     0    0    0>
            , <&key_physical_attrs   0   0    0    0     0    0    0>
            , <&key_physical_attrs   0   0    0    0     0    0    0>
            , <&key_physical_attrs   0   0    0    0     0    0    0>
            , <&key_physical_attrs   0   0    0    0     0    0    0>
            , <&key_physical_attrs 100 100 1100  400     0    0    0>  /* pos 84 */
            , <&key_physical_attrs 100 100 1000  400     0    0    0>  /* pos 85 */
            , <&key_physical_attrs 150 100  850  400     0    0    0>  /* pos 86 */
            , <&key_physical_attrs 100 100  925  300     0    0    0>  /* pos 87 */
            , <&key_physical_attrs   0   0    0    0     0    0    0>
            , <&key_physical_attrs   0   0    0    0     0    0    0>
            , <&key_physical_attrs   0   0    0    0     0    0    0>
            , <&key_physical_attrs   0   0    0    0     0    0    0>
            , <&key_physical_attrs 100 100 1100  500     0    0    0>  /* pos 92 */
            , <&key_physical_attrs 100 100 1000  500     0    0    0>  /* pos 93 */
            , <&key_physical_attrs 150 100  850  500     0    0    0>  /* pos 94 */
            , <&key_physical_attrs   0   0    0    0     0    0    0>;
    };
};
